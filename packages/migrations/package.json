{
  "name": "migrations",
  "version": "1.0.0",
  "description": "Package to handle Db migrations for all microservices DBs",
  "main": "lib/migrations.js",
  "scripts": {
    "db:migrate": "run-s db:migrate:*",
    "db:migrate-down": "run-s db:migrate-down:*",
    "db:migrate-reset": "run-s db:migrate-reset:*",
    "db:migrate:payment-service": "db-migrate up --config payment-service/database.json -m payment-service/migrations",
    "db:migrate-down:payment-service": "db-migrate down --config payment-service/database.json -m payment-service/migrations",
    "db:migrate-reset:payment-service": "db-migrate reset --config payment-service/database.json -m payment-service/migrations",
    "db:migrate:temple-service": "db-migrate up --config temple-service/database.json -m temple-service/migrations",
    "db:migrate-down:temple-service": "db-migrate down --config temple-service/database.json -m temple-service/migrations",
    "db:migrate-reset:temple-service": "db-migrate reset --config temple-service/database.json -m temple-service/migrations",
    "db:migrate:auth-service": "db-migrate up --config auth-service/database.json -m auth-service/migrations",
    "db:migrate-down:auth-service": "db-migrate down --config auth-service/database.json -m auth-service/migrations",
    "db:migrate-reset:auth-service": "db-migrate reset --config auth-service/database.json -m auth-service/migrations"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "db-migrate": "^1.0.0-beta.21",
    "dotenv": "^16.4.5",
    "dotenv-extended": "^2.9.0",
    "kindof": "^2.0.0",
    "db-migrate-pg": "^1.3.0"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.0",
    "npm-run-all": "^4.1.5"
  }
}